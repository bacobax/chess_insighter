# Copy to .env and fill in. .env is read by docker compose (both for ${...}
# interpolation in docker-compose.yml and as the api container's environment)
# and by the local dev server. Never commit .env.

# --- Hosting (docker compose) -------------------------------------------------
# Production: your domain (Caddy fetches an HTTPS certificate for it).
# Local docker test: leave unset (defaults to :80) and run with HTTP_PORT=8080.
SITE_ADDRESS=chess.example.com

# --- Backend authentication ---------------------------------------------------
# Generate with: openssl rand -hex 32
AUTH_JWT_SECRET=change-me
AUTH_JWT_ISSUER=chess-insighter
AUTH_SESSION_DAYS=7
AUTH_VERIFICATION_HOURS=24
# true in production (HTTPS); false for plain-http local testing
AUTH_COOKIE_SECURE=true
# Public URL of the app (used in verification emails and the WebSocket origin check)
FRONTEND_URL=https://chess.example.com

# --- Resend (a verified sender/domain is required) ----------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- MongoDB Atlas (all app persistence) --------------------------------------
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/
# Use a separate database name in production so local dev never touches real data
MONGODB_DB=chess_insighter_prod

# --- Lichess opening explorer -------------------------------------------------
# Personal API token (no scopes needed) from https://lichess.org/account/oauth/token.
# Used live by the API for repertoire positions past the named opening lines
# (cached in MongoDB) and by build_opening_popularity.py. Without it, those
# positions report "unavailable".
LICHESS_API_TOKEN=

# --- Local dev only -----------------------------------------------------------
# VITE_DEV_API_PROXY_TARGET=http://localhost:8000
